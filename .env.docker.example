# Environment variables for Hotelier Backend (Docker / hotelier-infra)

# Application configuration
NODE_ENV=development
PORT=3001

# PostgreSQL database (Docker network)
DATABASE_URL=postgresql://hotelier_dev:hotelier_dev_password@postgres:5432/hotelier_dev
BOOKING_DATABASE_URL=postgresql://hotelier_dev:hotelier_dev_password@postgres:5432/hotelier_dev

NOTIFICATIONS_DATABASE_URL=postgresql://hotelier_dev:hotelier_dev_password@postgres:5432/hotelier_dev

# RabbitMQ URL used by backend containers
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# JWT Secret (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Authentication configuration
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend URLs
FRONTEND_URL=http://localhost:3000

# Email configuration (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Upload configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads

# Redis (optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Logging configuration
LOG_LEVEL=debug
